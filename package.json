{
  "name": "ruq-website-mockup",
  "version": "0.1.0",
  "private": true,
  "description": "Redesign base for riseupqueens.com — static build, content extracted from the live site",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && npm run css",
    "css": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o dist/styles.css --minify",
    "dev": "node scripts/build.mjs && npm run css -- --watch",
    "serve": "node scripts/serve.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
